@baseUrl = http://localhost:3000
@apiUrl = {{baseUrl}}/api

# Guarda estos valores tras register/login
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJfaWQiOiI2OWRkMTliMjJjYjNlNjU5YjlkODRiOTkiLCJyb2xlIjoiYWRtaW4iLCJpYXQiOjE3NzYwOTc3MTQsImV4cCI6MTc3NjEwNDkxNH0.0Vp7ex7S1vTx8Kkxx9lIvFVC0x22779LTizmEM5T9BI
@refreshToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJfaWQiOiI2OWRkMTgwMDA1ZDVkYTNiNzE1YzVlN2QiLCJpYXQiOjE3NzYwOTc5MjAsImV4cCI6MTc3NjcwMjcyMH0.nGfN66wEj2zd5UjSktClS0S9N87_vrwWsjXaZ4QEoLM
@verifyCode = 227274

###############################################
# HEALTH CHECK
###############################################

GET {{baseUrl}}/health

###############################################
# 1. REGISTER — POST /api/user/register
###############################################

POST {{apiUrl}}/user/register
Content-Type: application/json

{
  "email": "prueba3@test.com",
  "password": "Test1234!",
  "name": "Rodrigo",
  "lastName": "Lopez",
  "nif": "12345978W"
}

###############################################
# 2. VALIDATE EMAIL — PUT /api/user/validation
# El código llega por consola (notification service)
###############################################

PUT {{apiUrl}}/user/validation
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "{{verifyCode}}"
}

###############################################
# 3. LOGIN — POST /api/user/login
###############################################

POST {{apiUrl}}/user/login
Content-Type: application/json

{
  "email": "prueba2@test.com",
  "password": "Test1234!"
}

###############################################
# 4. GET PERFIL — GET /api/user
###############################################

GET {{apiUrl}}/user
Authorization: Bearer {{token}}

###############################################
# 5. ACTUALIZAR DATOS PERSONALES — PUT /api/user/register
###############################################

PUT {{apiUrl}}/user/register
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Rodrigo",
  "lastName": "López Jiménez",
  "nif": "12345644A"
}

###############################################
# 6a. ONBOARDING EMPRESA — PATCH /api/user/company (freelance)
###############################################

PATCH {{apiUrl}}/user/company
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "isFreelance": true
}

###############################################
# 6b. ONBOARDING EMPRESA — PATCH /api/user/company (empresa)
###############################################

PATCH {{apiUrl}}/user/company
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "isFreelance": false,
  "name": "Mi Empresa SL",
  "cif": "B12345678",
  "address": {
    "street": "Calle Mayor",
    "number": "1",
    "postal": "28001",
    "city": "Madrid",
    "province": "Madrid"
  }
}

###############################################
# 7. SUBIR LOGO — PATCH /api/user/logo
###############################################

PATCH {{apiUrl}}/user/logo
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="logo"; filename="logo.png"
Content-Type: image/png

< ./logo.png
--boundary--

###############################################
# 8. REFRESH TOKEN — POST /api/user/refresh
###############################################

POST {{apiUrl}}/user/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###############################################
# 9. LOGOUT — POST /api/user/logout
###############################################

POST {{apiUrl}}/user/logout
Authorization: Bearer {{token}}

###############################################
# 10a. DELETE (soft) — DELETE /api/user
###############################################

DELETE {{apiUrl}}/user
Authorization: Bearer {{token}}

###############################################
# 10b. DELETE (hard) — DELETE /api/user?soft=false
###############################################

DELETE {{apiUrl}}/user?soft=false
Authorization: Bearer {{token}}

###############################################
# 11. INVITE (solo admin) — POST /api/user/invite
###############################################

POST {{apiUrl}}/user/invite
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "email": "invitado@test.com"
}

###############################################
# 12. CAMBIAR CONTRASEÑA — PUT /api/user/password
###############################################

PUT {{apiUrl}}/user/password
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "currentPassword": "Test1234!",
  "newPassword": "NewPass1234!",
  "confirmPassword": "NewPass1234!"
}

###############################################
# ERRORES — validación
###############################################

# Email inválido
POST {{apiUrl}}/user/register
Content-Type: application/json

{
  "email": "no-es-un-email",
  "password": "Test1234!",
  "name": "Test",
  "lastName": "User",
  "nif": "12345678A"
}

###

# Password débil
POST {{apiUrl}}/user/register
Content-Type: application/json

{
  "email": "otro@test.com",
  "password": "debil",
  "name": "Test",
  "lastName": "User",
  "nif": "12345678A"
}

###

# Ruta no existente — 404
GET {{apiUrl}}/ruta-que-no-existe
